<launch>
  <!-- Compatibility alias; the configuration selects the input, not the filename. -->
  <arg name="config_dir" default="" />
  <arg name="device_config_file" default="" />
  <arg name="video_config_file" default="" />
  <arg name="decoder_preload" default="" />
  <include file="$(find epgeneral_video_srt)/launch/epgeneral_video_srt.launch">
    <arg name="config_dir" value="$(arg config_dir)" />
    <arg name="device_config_file" value="$(arg device_config_file)" />
    <arg name="video_config_file" value="$(arg video_config_file)" />
    <arg name="decoder_preload" value="$(arg decoder_preload)" />
  </include>
</launch>
