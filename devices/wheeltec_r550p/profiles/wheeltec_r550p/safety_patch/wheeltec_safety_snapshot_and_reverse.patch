     )
 
 
+def sanitized_velocity(
+    linear_x,
+    angular_z,
+    max_linear_speed,
+    max_angular_speed,
+    linear_deadband,
+    angular_deadband,
+    allow_reverse,
+):
+    """Clamp a planner command without ever leaking prohibited reverse motion."""
+    output_linear_x = max(-max_linear_speed, min(max_linear_speed, linear_x))
+    output_angular_z = max(
+        -max_angular_speed, min(max_angular_speed, angular_z)
+    )
+    if (not allow_reverse and output_linear_x < 0.0) or (
+        abs(output_linear_x) <= linear_deadband
+    ):
+        output_linear_x = 0.0
+    if abs(output_angular_z) <= angular_deadband:
+        output_angular_z = 0.0
+    return output_linear_x, output_angular_z
+
