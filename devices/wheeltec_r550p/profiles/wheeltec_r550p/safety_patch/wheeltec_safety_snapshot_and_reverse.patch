     return output
 
 
+def costmap_cell_overlaps_body(
+    center_x,
+    center_y,
+    resolution,
+    cell_yaw,
+    body_front,
+    body_rear,
+    body_half_width,
+):
+    """Return whether an oriented square costmap cell overlaps the robot body."""
+    values = (
+        center_x,
+        center_y,
+        resolution,
+        cell_yaw,
+        body_front,
+        body_rear,
+        body_half_width,
+    )
+    if not all(math.isfinite(value) for value in values):
+        raise ValueError("costmap/body geometry must be finite")
+    if (
+        resolution <= 0.0
+        or body_front <= 0.0
+        or body_rear <= 0.0
+        or body_half_width <= 0.0
+    ):
+        raise ValueError("costmap/body dimensions must be positive")
+
+    body_center_x = (body_front - body_rear) / 2.0
+    body_half_length = (body_front + body_rear) / 2.0
+    delta_x = center_x - body_center_x
+    delta_y = center_y
+    cosine = math.cos(cell_yaw)
+    sine = math.sin(cell_yaw)
+    cell_axes = ((cosine, sine), (-sine, cosine))
+    axes = ((1.0, 0.0), (0.0, 1.0)) + cell_axes
+    cell_half = resolution / 2.0
+
+    for axis_x, axis_y in axes:
+        separation = abs(delta_x * axis_x + delta_y * axis_y)
+        body_projection = (
+            body_half_length * abs(axis_x)
+            + body_half_width * abs(axis_y)
+        )
+        cell_projection = cell_half * (
+            abs(axis_x * cell_axes[0][0] + axis_y * cell_axes[0][1])
+            + abs(axis_x * cell_axes[1][0] + axis_y * cell_axes[1][1])
+        )
+        if separation > body_projection + cell_projection + 1e-12:
+            return False
+    return True
+
+
+def costmap_cell_blocks(value, lethal_threshold, unknown_is_unsafe,
+                        overlaps_body):
+    """Classify a costmap cell without masking unknown space in the body."""
+    if value < 0:
+        return bool(unknown_is_unsafe)
+    if value < lethal_threshold:
+        return False
+    return not overlaps_body
+
