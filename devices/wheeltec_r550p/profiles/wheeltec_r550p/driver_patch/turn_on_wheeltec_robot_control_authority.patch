+class ControlAuthorityLease
+{
+	public:
+		using Clock = std::chrono::steady_clock;
+		using TimePoint = Clock::time_point;
+
+		void SetHeartbeatTimeout(double timeout_seconds)
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			timeout_ = std::chrono::duration<double>(timeout_seconds);
+		}
+
+		bool Enable(const TimePoint& now = Clock::now())
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			if (fault_latched_)
+				return false;
+			autonomous_ = true;
+			last_heartbeat_ = now;
+			has_heartbeat_ = true;
+			return true;
+		}
+
+		void Heartbeat(const TimePoint& now = Clock::now())
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			if (!autonomous_ || fault_latched_)
+				return;
+			last_heartbeat_ = now;
+			has_heartbeat_ = true;
+		}
+
+		bool ShouldWrite(const TimePoint& now = Clock::now())
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			if (fault_latched_)
+				return true;
+			if (!autonomous_)
+				return false;
+			const bool heartbeat_fresh =
+			    has_heartbeat_ && now >= last_heartbeat_ &&
+			    std::chrono::duration<double>(now - last_heartbeat_) <= timeout_;
+			if (!heartbeat_fresh)
+			{
+				autonomous_ = false;
+				fault_latched_ = true;
+			}
+			return true;
+		}
+
+		void Stop()
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			autonomous_ = false;
+			fault_latched_ = true;
+			has_heartbeat_ = false;
+		}
+
+		void ResetToManual()
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			autonomous_ = false;
+			fault_latched_ = false;
+			has_heartbeat_ = false;
+		}
+
+		bool IsAutonomous() const
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			return autonomous_;
+		}
+
+		bool IsFaultLatched() const
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			return fault_latched_;
+		}
+
+	private:
+		mutable std::mutex mutex_;
+		bool autonomous_ = false;
+		bool fault_latched_ = false;
+		bool has_heartbeat_ = false;
+		TimePoint last_heartbeat_;
+		std::chrono::duration<double> timeout_{0.50};
+};
 }  // namespace wheeltec_driver_safety
 
