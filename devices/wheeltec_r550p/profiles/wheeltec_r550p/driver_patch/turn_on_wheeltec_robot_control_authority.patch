+void turn_on_robot::Publish_Control_State()
+{
+  std_msgs::Bool message;
+  message.data = Control_Authority.IsAutonomous() &&
+                 !Control_Authority.IsFaultLatched();
+  control_enabled_publisher.publish(message);
+}
+
+bool turn_on_robot::Set_Autonomous_Callback(
+    std_srvs::SetBool::Request& request,
+    std_srvs::SetBool::Response& response)
+{
+  Cmd_Watchdog.Lock();
+  Last_Command_Was_Fresh.store(false);
+  if (request.data)
+  {
+    if (!Control_Authority.Enable())
+    {
+      response.success = false;
+      response.message = "control fault is latched; reset authority first";
+      Publish_Control_State();
+      return true;
+    }
+    response.success = true;
+    response.message = "autonomous serial authority enabled";
+    Publish_Control_State();
+    return true;
+  }
+  Send_Stop_Burst(shutdown_stop_repeats);
+  Control_Authority.ResetToManual();
+  response.success = true;
+  response.message = "manual controller authority restored";
+  Publish_Control_State();
+  return true;
+}
+
+bool turn_on_robot::Stop_Callback(
+    std_srvs::Trigger::Request&,
+    std_srvs::Trigger::Response& response)
+{
+  Control_Authority.Stop();
+  Cmd_Watchdog.Lock();
+  Last_Command_Was_Fresh.store(false);
+  Send_Stop_Burst(shutdown_stop_repeats);
+  response.success = true;
+  response.message = "autonomous stop latched";
+  Publish_Control_State();
+  return true;
+}
+
+bool turn_on_robot::Reset_Authority_Callback(
+    std_srvs::Trigger::Request&,
+    std_srvs::Trigger::Response& response)
+{
+  if (Cmd_Source_Guard.IsFaultLatched())
+  {
+    response.success = false;
+    response.message = "publisher source fault requires driver restart";
+    return true;
+  }
+  Cmd_Watchdog.Lock();
+  Last_Command_Was_Fresh.store(false);
+  Send_Stop_Burst(shutdown_stop_repeats);
+  Control_Authority.ResetToManual();
+  response.success = true;
+  response.message = "fault reset; manual controller authority restored";
+  Publish_Control_State();
+  return true;
+}
