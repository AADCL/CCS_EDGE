+TEST(ControlAuthorityLeaseTest, ManualModeDoesNotWriteSerial)
+{
+  wheeltec_driver_safety::ControlAuthorityLease authority;
+  const auto now =
+      wheeltec_driver_safety::ControlAuthorityLease::TimePoint(Milliseconds(1000));
+
+  EXPECT_FALSE(authority.ShouldWrite(now));
+  EXPECT_FALSE(authority.IsAutonomous());
+  EXPECT_FALSE(authority.IsFaultLatched());
+}
+
+TEST(ControlAuthorityLeaseTest, HeartbeatExpiryLatchesZeroOutput)
+{
+  wheeltec_driver_safety::ControlAuthorityLease authority;
+  authority.SetHeartbeatTimeout(0.50);
+  const auto enabled =
+      wheeltec_driver_safety::ControlAuthorityLease::TimePoint(Milliseconds(1000));
+
+  ASSERT_TRUE(authority.Enable(enabled));
+  authority.Heartbeat(enabled + Milliseconds(100));
+  EXPECT_TRUE(authority.ShouldWrite(enabled + Milliseconds(600)));
+  EXPECT_TRUE(authority.IsAutonomous());
+  EXPECT_FALSE(authority.IsFaultLatched());
+
+  EXPECT_TRUE(authority.ShouldWrite(enabled + Milliseconds(601)));
+  EXPECT_FALSE(authority.IsAutonomous());
+  EXPECT_TRUE(authority.IsFaultLatched());
+  EXPECT_FALSE(authority.Enable(enabled + Milliseconds(700)));
+}
+
+TEST(ControlAuthorityLeaseTest, ResetRestoresManualAuthority)
+{
+  wheeltec_driver_safety::ControlAuthorityLease authority;
+  authority.Stop();
+  ASSERT_TRUE(authority.IsFaultLatched());
+
+  authority.ResetToManual();
+
+  EXPECT_FALSE(authority.ShouldWrite());
+  EXPECT_FALSE(authority.IsAutonomous());
+  EXPECT_FALSE(authority.IsFaultLatched());
+}
