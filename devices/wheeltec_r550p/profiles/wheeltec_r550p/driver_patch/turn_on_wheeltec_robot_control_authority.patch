+inline std::array<uint8_t, SEND_DATA_SIZE> BuildVelocityPacket(
+    const geometry_msgs::Twist& command)
+{
+	std::array<uint8_t, SEND_DATA_SIZE> packet{};
+	packet[0] = FRAME_HEADER;
+	const auto scaled_velocity = [](double velocity) {
+		const double scaled = std::max(
+		    static_cast<double>(std::numeric_limits<int16_t>::min()),
+		    std::min(static_cast<double>(std::numeric_limits<int16_t>::max()),
+		             velocity * 1000.0));
+		return static_cast<int16_t>(scaled);
+	};
+	const auto store_velocity = [&packet, &scaled_velocity](
+	    std::size_t high, double velocity) {
+		const uint16_t encoded =
+		    static_cast<uint16_t>(scaled_velocity(velocity));
+		packet[high] = static_cast<uint8_t>((encoded >> 8) & 0xff);
+		packet[high + 1] = static_cast<uint8_t>(encoded & 0xff);
+	};
+	store_velocity(3, command.linear.x);
+	store_velocity(5, command.linear.y);
+	store_velocity(7, command.angular.z);
+	for (std::size_t i = 0; i < 9; ++i)
+		packet[9] ^= packet[i];
+	packet[10] = FRAME_TAIL;
+	return packet;
+}
