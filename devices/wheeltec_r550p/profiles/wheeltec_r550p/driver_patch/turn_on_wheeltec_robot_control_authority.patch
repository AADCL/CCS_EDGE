+int16_t DecodeSignedVelocity(
+    const std::array<uint8_t, SEND_DATA_SIZE>& packet, std::size_t high)
+{
+  return static_cast<int16_t>(
+      (static_cast<uint16_t>(packet[high]) << 8) |
+      static_cast<uint16_t>(packet[high + 1]));
+}
+
+void ExpectPacketChecksum(
+    const std::array<uint8_t, SEND_DATA_SIZE>& packet)
+{
+  uint8_t checksum = 0;
+  for (std::size_t index = 0; index < 9; ++index)
+    checksum ^= packet[index];
+  EXPECT_EQ(checksum, packet[9]);
+  EXPECT_EQ(FRAME_HEADER, packet[0]);
+  EXPECT_EQ(FRAME_TAIL, packet[10]);
+}
+
+TEST(VelocityPacketTest, EncodesForwardAndReverseWithSign)
+{
+  geometry_msgs::Twist command;
+  command.linear.x = 0.125;
+  std::array<uint8_t, SEND_DATA_SIZE> packet =
+      wheeltec_driver_safety::BuildVelocityPacket(command);
+  EXPECT_EQ(125, DecodeSignedVelocity(packet, 3));
+  EXPECT_EQ(0, DecodeSignedVelocity(packet, 7));
+  ExpectPacketChecksum(packet);
+
+  command.linear.x = -0.125;
+  packet = wheeltec_driver_safety::BuildVelocityPacket(command);
+  EXPECT_EQ(-125, DecodeSignedVelocity(packet, 3));
+  EXPECT_EQ(0, DecodeSignedVelocity(packet, 7));
+  ExpectPacketChecksum(packet);
+}
+
+TEST(VelocityPacketTest, EncodesPureTurnWithoutForwardActivation)
+{
+  geometry_msgs::Twist command;
+  command.angular.z = -0.25;
+  const std::array<uint8_t, SEND_DATA_SIZE> packet =
+      wheeltec_driver_safety::BuildVelocityPacket(command);
+
+  EXPECT_EQ(0, DecodeSignedVelocity(packet, 3));
+  EXPECT_EQ(0, DecodeSignedVelocity(packet, 5));
+  EXPECT_EQ(-250, DecodeSignedVelocity(packet, 7));
+  ExpectPacketChecksum(packet);
+}
